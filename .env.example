# AquaSentinel Environment Configuration

# Database
DATABASE_URL=sqlite:///./aquasentinel.db

# Device Settings
DEFAULT_DEVICE_ID=AQUA-01
WATER_BODY_NAME=Simulated Reservoir 01

# LLM Provider ("sarvam" or "fallback")
LLM_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL_NAME=sarvam-2b

# ngrok Tunnel (Reference for Wokwi main.ino)
NGROK_FORWARDING_URL=https://your-subdomain.ngrok-free.app
