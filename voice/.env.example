# Copy to .env and fill in for local dev
DATABASE_URL=sqlite:///./aquasentinel.db
AQUASENTINEL_API_KEY=changeme-dev-key

# Anomaly detection tuning
BASELINE_WINDOW=60
ZSCORE_THRESHOLD=3.0
MIN_READINGS_FOR_BASELINE=10

# n8n webhook that receives {"event_id": "..."} when a new anomaly fires
N8N_WEBHOOK_URL=http://localhost:5678/webhook/aquasentinel-anomaly

CORS_ORIGINS=*
