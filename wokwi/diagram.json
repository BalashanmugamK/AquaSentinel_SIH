{
  "version": 1,
  "author": "AquaSentinel Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-ds18b20",
      "id": "temp_sensor",
      "top": -120,
      "left": 180,
      "attrs": { "temperature": "27" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_pullup",
      "top": -60,
      "left": 140,
      "attrs": { "resistance": "4700" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_ph",
      "top": 220,
      "left": -140,
      "attrs": { "label": "pH (simulated)", "value": "514" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_turb",
      "top": 220,
      "left": 0,
      "attrs": { "label": "Turbidity (simulated)", "value": "50" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_ec",
      "top": 220,
      "left": 140,
      "attrs": { "label": "TDS / EC (simulated)", "value": "614" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    [ "esp:3V3", "temp_sensor:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "temp_sensor:GND", "black", [ "v0" ] ],
    [ "esp:4", "temp_sensor:DQ", "green", [ "v0" ] ],
    [ "esp:3V3", "r_pullup:1", "red", [ "v0" ] ],
    [ "esp:4", "r_pullup:2", "green", [ "v0" ] ],
    
    [ "esp:3V3", "pot_ph:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot_ph:GND", "black", [ "v0" ] ],
    [ "esp:34", "pot_ph:SIG", "blue", [ "v0" ] ],
    
    [ "esp:3V3", "pot_turb:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "pot_turb:GND", "black", [ "v0" ] ],
    [ "esp:35", "pot_turb:SIG", "orange", [ "v0" ] ],
    
    [ "esp:3V3", "pot_ec:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "pot_ec:GND", "black", [ "v0" ] ],
    [ "esp:32", "pot_ec:SIG", "purple", [ "v0" ] ]
  ],
  "dependencies": {}
}
